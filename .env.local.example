# ==============================================================================
# Environment Variables Example for Next.js Cinematic Portfolio
# Copy this file to `.env.local` and replace the placeholder values:
#   cp .env.local.example .env.local
# ==============================================================================

# ── 1. SUPABASE DATABASE & STORAGE CONFIGURATION ─────────────────────────────
# Required for: Projects, Works, Inquiries, Reviews, Analytics, File Uploads.
# Find these in your Supabase Project Settings -> API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Service Role Key has administrative privileges to bypass RLS for server-side API routes & uploads.
# Keep this secret! Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── 2. ADMIN AUTHENTICATION & SECURITY ────────────────────────────────────────
# Password required to log in to the hidden admin panel at /admin/login
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# Strong secret used by 'jose' to sign and verify admin session JWT cookies.
# Generate a random 32+ character string (e.g. `openssl rand -hex 32`)
JWT_SECRET="generate-a-secure-random-32-character-secret-key-here"

# Password required to bypass the "Coming Soon" screen when maintenance mode is enabled in DB settings.
COMING_SOON_PASSWORD="YourComingSoonBypassPassword"

# ── 3. RESEND EMAIL SERVICE ───────────────────────────────────────────────────
# Required for: Contact form inquiry delivery and admin email replies.
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_123456789_your_resend_api_key"

# Email address used as the sender / recipient for notifications.
# NOTE: Must be a verified domain in Resend, or use "onboarding@resend.dev" for testing.
ADMIN_EMAIL="you@yourdomain.com"

# ── 4. SITE & CONTACT CONFIGURATION ──────────────────────────────────────────
# Canonical site URL without trailing slash (e.g. https://abhinavtiwary.com)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# WhatsApp number for direct client chat popup and contact page fallback.
# Include country code without '+' or spaces (e.g. 919876543210 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# ── 5. SEARCH ENGINE VERIFICATION (OPTIONAL) ──────────────────────────────────
# Google Search Console HTML tag content value
NEXT_PUBLIC_GOOGLE_VERIFICATION=""

# Bing Webmaster Tools verification code (msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION=""
